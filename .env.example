# ── AI درگاه شخصی (SPEC-013) — کلیدها فقط روی سرور ─────────────────────
# روی Vercel همین نام‌ها در Shared Environment Variables هستند؛ روی اجرای لوکال
# هر زیرمجموعه‌ای از آن‌ها را که خواستید اینجا بگذارید. هیچ مقداری در باندل یا APK نمی‌رود.
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_KEY_P1=
# GEMINI_KEY_P2=
# GEMINI_KEY_P3=
# AGNES_API_KEY=
# MISTRAL_API_KEY=
# HUGGINGFACE_API_KEY=
# DEEPSEEK_API_KEY=
# APMIX_API_KEY=
# FIREWORKS_API_KEY=
# قفل اختیاری درگاه (حداقل ۸ نویسه)؛ همان مقدار در تنظیمات اپ → دسترسی API وارد می‌شود.
# KONKLANCER_OWNER_TOKEN=

# ── اسکنر (SPEC-004 / SPEC-007) ─────────────────────────────────────────
KONKLANCER_SCAN_PLATFORMS=
KONKLANCER_SCAN_TELEGRAM=
KONKLANCER_SCAN_CATEGORIES=
KONKLANCER_SCAN_INCLUDE=
KONKLANCER_SCAN_EXCLUDE=
KONKLANCER_SCAN_PAGES=
KONKLANCER_SCAN_DELAY=
KONKLANCER_SCAN_MIN_SCORE=
KONKLANCER_SCAN_INTERVAL_MIN=
KONKLANCER_SCAN_AUTO=
KONKLANCER_PYTHON=
# 1 = رندر صفحه با مرورگر واقعی (Playwright) برای سایت‌های JS-محور
# نیازمند: pip install playwright && playwright install chromium
KONKLANCER_BROWSER=
# اگر 1 باشد، پروژه‌های ساختگی نمایشی تولید می‌شوند (پیش‌فرض خاموش)
KONKLANCER_DEMO=

# ── فید ابری (اجرای اسکنر روی رانرهای گیت‌هاب) ───────────────────────────
KONKLANCER_CLOUD_FEED_REPO=
KONKLANCER_CLOUD_FEED_REF=
KONKLANCER_CLOUD_TOKEN=
KONKLANCER_CLOUD_POLL_MS=

# ── نتیجه‌ی پیشنهادها و امنیت (SPEC-005 / SPEC-003 R5) ──────────────────
# پیش‌فرض: data/konklancer.db — مقدار :memory: هم پذیرفته است
KONKLANCER_DB_PATH=
# با تنظیم این مقدار (حداقل ۸ نویسه) همه‌ی /api/* به هدر x-api-token نیاز دارند
KONKLANCER_API_TOKEN=

# ── اعلان تلگرام برای پروژه‌های بالای آستانه (SPEC-004 R7) ───────────────
KONKLANCER_TELEGRAM_BOT_TOKEN=
KONKLANCER_TELEGRAM_CHAT_ID=
# پیش‌فرض ۸۵
KONKLANCER_ALERT_THRESHOLD=

# AI gateway optional extras:
# NVIDIA_API_KEY=      # NVIDIA build.nvidia.com router (free dev credits) — only if you add it
# GITHUB_TOKEN=        # GitHub Models catalog — only if you add it; never rely on CI tokens
#
# Supabase browser authentication: both values must belong to the same project.
# These are public client configuration, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TELEGRAM_BOT_USERNAME=
VITE_AUTH_REQUIRED=false
# JWT verification for the self-hosted API; secret stays on the server.
SUPABASE_JWT_SECRET=
# Optional: explicitly permit the GitHub CLI fallback for cloud requests.
# It uses KONKLANCER_CLOUD_TOKEN, not the machine's gh login.
KONKLANCER_CLOUD_GH_FALLBACK=0
# Optional legacy feed relay, only if independently provisioned and reviewed.
# This is separate from the authentication project; do not use a service-role key.
VITE_FEED_SUPABASE_URL=
VITE_FEED_SUPABASE_ANON_KEY=
