# ── AI gateway (SPEC-006) ────────────────────────────────────────────────
# فقط روی سرور/Vercel؛ این کلید باید در USERS_JSON درگاه Konkred مجاز باشد.
# هرگز آن را در VITE_*، APK یا مرورگر قرار ندهید.
KONKRED_GATEWAY_URL=https://api.konkred.xyz
KONKRED_API_KEY=
# any | strict — پیش‌فرض مورد تأیید SPEC-006: any
KONKRED_PRIVACY=any
# مهلت هر تماس (میلی‌ثانیه) و عمر کش تحلیل (دقیقه)
KONKRED_TIMEOUT_MS=45000
KONKRED_CACHE_TTL_MINUTES=1440

# ── اسکنر (SPEC-004 / SPEC-007) ─────────────────────────────────────────
KONKLANCER_SCAN_PLATFORMS=
KONKLANCER_SCAN_TELEGRAM=
KONKLANCER_SCAN_CATEGORIES=
KONKLANCER_SCAN_INCLUDE=
KONKLANCER_SCAN_EXCLUDE=
KONKLANCER_SCAN_PAGES=
KONKLANCER_SCAN_DELAY=
KONKLANCER_SCAN_MIN_SCORE=
KONKLANCER_SCAN_INTERVAL_MIN=
KONKLANCER_SCAN_AUTO=
KONKLANCER_PYTHON=
# 1 = رندر صفحه با مرورگر واقعی (Playwright) برای سایت‌های JS-محور
# نیازمند: pip install playwright && playwright install chromium
KONKLANCER_BROWSER=
# اگر 1 باشد، پروژه‌های ساختگی نمایشی تولید می‌شوند (پیش‌فرض خاموش)
KONKLANCER_DEMO=

# ── فید ابری (اجرای اسکنر روی رانرهای گیت‌هاب) ───────────────────────────
KONKLANCER_CLOUD_FEED_REPO=
KONKLANCER_CLOUD_FEED_REF=
KONKLANCER_CLOUD_TOKEN=
KONKLANCER_CLOUD_POLL_MS=

# ── نتیجه‌ی پیشنهادها و امنیت (SPEC-005 / SPEC-003 R5) ──────────────────
# پیش‌فرض: data/konklancer.db — مقدار :memory: هم پذیرفته است
KONKLANCER_DB_PATH=
# با تنظیم این مقدار (حداقل ۸ نویسه)، /api/* به هدر x-api-token نیاز دارد.
KONKLANCER_API_TOKEN=
# توکن برنامه→سرور؛ در Vercel و (برای page relay) Supabase Edge secret تنظیم شود
# و در Settings همان دستگاه وارد شود. با KONKRED_API_KEY متفاوت است.
KONKLANCER_RELAY_TOKEN=

# ── اعلان تلگرام برای پروژه‌های بالای آستانه (SPEC-004 R7) ───────────────
KONKLANCER_TELEGRAM_BOT_TOKEN=
KONKLANCER_TELEGRAM_CHAT_ID=
# پیش‌فرض ۸۵
KONKLANCER_ALERT_THRESHOLD=
